---
import Layout from './Layout.astro';

interface Props {
  title: string;
  subtitle?: string;
  description: string;
  image?: string;
  imagePosition?: string;
  date: string;
  readTime: string;
  tags: string[];
  author?: string;
}

const {
  title,
  subtitle,
  description,
  image,
  imagePosition = 'center',
  date,
  readTime,
  tags,
  author = 'Jhonatan Serna',
} = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout
  title={title}
  description={description}
  image={image}
  type="article"
  article={{
    publishedTime: date,
    author,
    tags,
  }}
>
  <!-- Reading progress bar -->
  <div id="reading-progress" style="width: 0%"></div>

  <!-- Article Hero -->
  <section class="relative pt-10 pb-0 overflow-hidden">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-s-muted text-xs mb-8 font-mono">
        <a href="/" class="hover:text-s-emerald transition-colors">Home</a>
        <span>/</span>
        <a href="/#writing" class="hover:text-s-emerald transition-colors">Writing</a>
        <span>/</span>
        <span class="text-s-muted-light truncate max-w-xs">{title}</span>
      </nav>

      <!-- Tags -->
      <div class="flex flex-wrap gap-2 mb-5">
        {tags.map(tag => (
          <span class="s-tag">{tag}</span>
        ))}
      </div>

      <!-- Title -->
      <h1 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-s-text leading-tight mb-4">
        {title}
      </h1>

      {subtitle && (
        <p class="text-s-emerald text-lg font-medium mb-5">{subtitle}</p>
      )}

      <!-- Meta -->
      <div class="flex flex-wrap items-center gap-5 text-s-muted text-xs font-mono mb-10 pb-8 border-b border-s-border">
        <div class="flex items-center gap-2">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
          <span>{author}</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <span>{formattedDate}</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span>{readTime}</span>
        </div>
      </div>
    </div>

    <!-- Hero Image (optional) -->
    {image && (
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-0">
        <div class="relative rounded-lg overflow-hidden">
          <img
            src={image}
            alt={title}
            class="w-full h-56 sm:h-72 lg:h-80 object-cover"
            style={`object-position: ${imagePosition}`}
          />
          <div class="absolute inset-0 bg-gradient-to-t from-s-dark/60 via-transparent to-transparent"></div>
          <div class="absolute inset-0 rounded-lg border border-white/5 pointer-events-none"></div>
        </div>
      </div>
    )}
  </section>

  <!-- Article Content -->
  <section class="py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_220px] gap-12">
        <!-- Main content -->
        <div class="prose-s">
          <slot />
        </div>

        <!-- Sidebar -->
        <aside class="hidden lg:block">
          <div class="sticky top-20 space-y-5">
            <!-- Author card -->
            <div class="glass-card rounded-lg p-4">
              <h3 class="text-s-muted font-mono text-xs uppercase tracking-widest mb-3">Author</h3>
              <div class="flex items-center gap-3 mb-3">
                <div class="w-9 h-9 rounded-full overflow-hidden border border-white/10 flex-shrink-0">
                  <img src="/images/profile_pic.jpg" alt={author} class="w-full h-full object-cover" />
                </div>
                <div>
                  <p class="text-s-text text-sm font-medium">{author}</p>
                  <p class="text-s-muted text-xs">Physicist · Banker · Writer</p>
                </div>
              </div>
              <a href="/about" class="btn-outline text-xs py-1.5 px-3 w-full justify-center mt-2">
                About me
              </a>
            </div>

            <!-- Tags -->
            <div class="glass-card rounded-lg p-4">
              <h3 class="text-s-muted font-mono text-xs uppercase tracking-widest mb-3">Topics</h3>
              <div class="flex flex-wrap gap-1.5">
                {tags.map(tag => (
                  <span class="s-tag">{tag}</span>
                ))}
              </div>
            </div>

            <!-- Share -->
            <div class="glass-card rounded-lg p-4">
              <h3 class="text-s-muted font-mono text-xs uppercase tracking-widest mb-3">Share</h3>
              <div class="flex gap-2">
                <a
                  href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(Astro.url.href)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 btn-outline text-xs py-1.5 px-2 justify-center"
                >
                  X / Twitter
                </a>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Back to writing -->
  <section class="pb-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="section-divider mb-8"></div>
      <a href="/#writing" class="inline-flex items-center gap-2 text-s-muted hover:text-s-emerald transition-colors group text-sm">
        <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"/>
        </svg>
        Back to all writing
      </a>
    </div>
  </section>

  <!-- Reading progress script -->
  <script>
    const progressBar = document.getElementById('reading-progress');
    const article = document.querySelector('.prose-s');

    if (progressBar && article) {
      const updateProgress = () => {
        const articleTop = (article as HTMLElement).offsetTop;
        const articleHeight = (article as HTMLElement).offsetHeight;
        const windowHeight = window.innerHeight;
        const scrolled = window.scrollY;

        const progress = Math.min(
          Math.max((scrolled - articleTop + windowHeight * 0.5) / articleHeight, 0),
          1
        );

        progressBar.style.width = `${progress * 100}%`;
      };

      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();
    }
  </script>
</Layout>
