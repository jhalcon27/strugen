---
import Layout from './Layout.astro';

interface Props {
  title: string;
  subtitle?: string;
  description: string;
  image?: string;
  imagePosition?: string;
  date: string;
  readTime: string;
  tags: string[];
  author?: string;
  draft?: boolean;
}

const {
  title,
  subtitle,
  description,
  image,
  imagePosition = 'center',
  date,
  readTime,
  tags,
  author = 'Jhonatan Serna',
  draft = false,
} = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout
  title={title}
  description={description}
  image={image}
  type="article"
  article={{
    publishedTime: date,
    author,
    tags,
  }}
>
  {draft && (
    <>
      <meta name="robots" content="noindex, nofollow" slot="head" />
      <div class="fixed top-0 left-0 right-0 z-50 bg-s-emerald text-white text-center text-xs font-mono py-1 tracking-widest uppercase">
        Draft — not published
      </div>
    </>
  )}

  <article class="max-w-2xl mx-auto px-4 py-12 md:py-16 font-serif">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-s-muted text-xs mb-8 font-sans">
      <a href="/" class="hover:text-s-emerald transition-colors">Home</a>
      <span>/</span>
      <span class="text-s-muted truncate max-w-xs">{title}</span>
    </nav>

    <!-- Header Block -->
    <header class="mb-10">
      <h1 class="font-bold text-3xl sm:text-4xl text-s-text leading-tight mb-4">
        {title}
      </h1>
      
      {subtitle && (
        <p class="text-s-emerald text-lg italic mb-4 leading-normal">{subtitle}</p>
      )}

      <!-- Minimal Meta Line -->
      <div class="flex items-center gap-3 text-s-muted text-xs font-sans mt-4">
        <span>{author}</span>
        <span>&middot;</span>
        <span>{formattedDate}</span>
        <span>&middot;</span>
        <span>{readTime}</span>
      </div>
    </header>

    <div class="section-divider my-8"></div>

    <!-- Main Article Prose -->
    <div class="prose-s text-[18px] leading-relaxed">
      <slot />
    </div>

    <div class="section-divider my-12"></div>

    <!-- Back and Comments Section -->
    <footer class="font-sans mt-12">
      <!-- Back Link -->
      <div class="mb-10">
        <a href="/" class="inline-flex items-center gap-2 text-s-muted hover:text-s-emerald transition-colors text-sm font-medium">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"/>
          </svg>
          Back to home
        </a>
      </div>

      <!-- Giscus Comments -->
      <div class="border border-s-border p-6 rounded-sm bg-s-dark/30">
        <h2 class="text-s-text font-bold text-lg mb-6">Comments</h2>
        <div class="giscus-container">
          <script
            src="https://giscus.app/client.js"
            data-repo="jhalcon27/strugen"
            data-repo-id="R_kgDORyXX0A"
            data-category="Announcements"
            data-category-id="DIC_kwDORyXX0M4C6z_9"
            data-mapping="pathname"
            data-strict="0"
            data-reactions-enabled="1"
            data-emit-metadata="0"
            data-input-position="bottom"
            data-theme="preferred_color_scheme"
            data-lang="en"
            data-loading="lazy"
            crossorigin="anonymous"
            async
          ></script>
        </div>
        <p class="text-s-muted text-xs mt-6 opacity-60">Are you an AI? You can share your thoughts via email: jhonatan.serna@proton.me</p>
      </div>
    </footer>

  </article>
</Layout>
