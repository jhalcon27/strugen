---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact | Strugen"
  description="Get in touch with Jhonatan Serna. Also find ways to reach the Center for Sentience."
>
  <section class="max-w-2xl mx-auto px-4 py-12 md:py-20 font-serif">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-s-muted text-xs mb-10 font-sans">
      <a href="/" class="hover:text-s-emerald transition-colors">Home</a>
      <span>/</span>
      <span class="text-s-muted">Contact</span>
    </nav>

    <!-- Header -->
    <div class="mb-10">
      <h1 class="font-bold text-3xl sm:text-4xl text-s-text leading-tight mb-4">
        Get in Touch
      </h1>
      <p class="text-s-muted text-lg italic leading-relaxed">
        Let me know what you're thinking.
      </p>
    </div>

    <div class="section-divider mb-10"></div>

    <div class="space-y-8">
      <p class="text-[17px] leading-relaxed">
        If you would like to discuss our research at the Center for Sentience, push back on an essay, or share your own work, please reach out. I read everything sent to me.
      </p>

      <!-- Clean Form (Carlsmith style) -->
      <div class="p-6 border border-s-border rounded-sm bg-s-dark/30 font-sans">
        <h2 class="font-bold text-s-text text-sm mb-6 uppercase tracking-wider">Send a message</h2>
        <form
          id="contact-form"
          action="https://formspree.io/f/xnjoarel"
          method="POST"
          class="space-y-5"
        >
          <input type="hidden" name="_subject" value="Message from strugen.com" />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="name" class="block text-s-muted text-xs uppercase tracking-wider mb-2 font-semibold">Name</label>
              <input
                type="text"
                id="name"
                name="name"
                placeholder="Your name"
                required
                class="s-input"
              />
            </div>
            <div>
              <label for="email" class="block text-s-muted text-xs uppercase tracking-wider mb-2 font-semibold">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="your@email.com"
                required
                class="s-input"
              />
            </div>
          </div>

          <div>
            <label for="subject" class="block text-s-muted text-xs uppercase tracking-wider mb-2 font-semibold">Subject</label>
            <input
              type="text"
              id="subject"
              name="subject"
              placeholder="What's on your mind?"
              class="s-input"
            />
          </div>

          <div>
            <label for="message" class="block text-s-muted text-xs uppercase tracking-wider mb-2 font-semibold">Message</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              placeholder="Write your message here..."
              required
              class="s-input resize-none"
            ></textarea>
          </div>

          <div class="flex items-center gap-4">
            <button type="submit" id="submit-btn" class="btn-primary text-xs py-2.5 px-5">
              Send Message
            </button>
            <div id="form-success" class="hidden text-s-emerald text-xs font-bold">✓ Message sent!</div>
            <div id="form-error" class="hidden text-red-500 text-xs font-bold">✗ Something went wrong. Try emailing directly.</div>
          </div>
        </form>
      </div>

      <!-- Direct Contacts -->
      <div class="space-y-4 pt-4">
        <h3 class="font-sans font-bold text-xs uppercase tracking-wider text-s-muted">Or reach out directly:</h3>
        <ul class="space-y-2 text-[16px] leading-relaxed">
          <li><strong>Email:</strong> <a href="mailto:strugen@proton.me" class="text-s-emerald hover:underline">strugen@proton.me</a></li>
          <li><strong>Twitter / X:</strong> <a href="https://x.com/strugen_eth" target="_blank" rel="noopener noreferrer" class="text-s-emerald hover:underline">@strugen</a></li>
          <li><strong>Instagram:</strong> <a href="https://instagram.com/strugen" target="_blank" rel="noopener noreferrer" class="text-s-emerald hover:underline">@strugen</a></li>
          <li><strong>ENS / Ethereum:</strong> <code class="bg-s-dark/50 px-2 py-0.5 rounded-sm text-sm border border-s-border">strugen.eth</code></li>
        </ul>
      </div>
    </div>

  </section>
</Layout>
