---
import Layout from '../layouts/Layout.astro';

// Complete list of posts with dates and metadata
const posts = [
  {
    slug: 'happiness-conditional-vs-equanimity',
    title: 'Conditional Happiness vs. Equanimity',
    subtitle: "The fragility of reacting to life's favorable inputs.",
    description: 'An inquiry into why maintaining happiness under perfect external conditions is easy, and why the real challenge lies in building a non-reactive cognitive architecture.',
    date: '2026-06-15',
    readTime: '6 min read',
    draft: true,
    tags: ['Philosophy', 'Contemplation', 'Personal Growth']
  },
  {
    slug: 'how-to-focus-when-everything-is-interesting',
    title: 'How to Focus When Everything Is Interesting',
    subtitle: 'The cost of genuine curiosity.',
    description: 'When the problem is not motivation but too many things that genuinely deserve attention — an honest reckoning with what curiosity costs and what to do about it.',
    date: '2026-04-13',
    readTime: '6 min read',
    draft: true,
    tags: ['Personal Reflection', 'Productivity', 'Focus']
  },
  {
    slug: 'my-thoughts-on-a-good-life',
    title: 'My Thoughts on a Good Life',
    subtitle: 'Not a framework. Just what I actually think.',
    description: 'What a good life looks like from where I stand — shaped by Colombia, Scandinavia, and Zurich, and still not fully resolved.',
    date: '2026-04-13',
    readTime: '7 min read',
    draft: true,
    tags: ['Philosophy', 'Life', 'Reflections']
  },
  {
    slug: 'on-being-here',
    title: 'On Being Here',
    subtitle: 'A note on why I write.',
    description: 'I have less than 100 years on this planet. Writing is how I make sense of what I see, think, and feel.',
    date: '2026-03-27',
    readTime: '3 min read',
    draft: false,
    tags: ['Philosophy', 'Personal']
  },
  {
    slug: 'how-you-learn-to-change-from-sorrow',
    title: 'On grief, identity, and the grammar we inherit',
    subtitle: 'An insight from sorrow.',
    description: 'Pain is one of the most reliable drivers of awareness we have. A look at the patterns of identity formed in Colombia and tested in Europe.',
    date: '2024-05-15',
    readTime: '5 min read',
    draft: false,
    tags: ['Personal Reflection', 'Sorrow', 'Change']
  }
];

// Curated lists matching Joe Carlsmith's layout style
const favorites = [
  posts[4], // On grief, identity, and grammar
  posts[2], // My Thoughts on a Good Life
];

const valenceEssays = [
  {
    title: 'A Mathematical Framework for Affective Valence',
    subtitle: 'Spatially-constrained neural GWT & IIT architectures.',
    description: 'Our flagship Center for Sentience working paper (CSR-WP-05) exploring global broadcasting and local attractor dynamics to model pleasure and pain.',
    isExternal: true,
    url: 'https://centerforsentience.org/research/'
  },
  {
    title: 'The Logarithmic Nature of Pain and Pleasure',
    subtitle: 'From Kidney Stones to Qualia.',
    description: "Using a severe renal colic episode to explain the non-linear, exponential progression of physical pain, connecting it to the Qualia Research Institute's (QRI) valence theories.",
    isExternal: true,
    url: 'https://www.digitalpsychedelics.com'
  },
  {
    title: 'The Overfitted Brain Hypothesis',
    subtitle: 'Dreams as regularization in biological and artificial networks.',
    description: "Bridges our training pipelines with Erik Hoel's theory that dreams are a mathematical necessity (dropout/noise injection) to keep plastic minds from overfitting.",
    isExternal: true,
    url: 'https://www.digitalpsychedelics.com'
  }
];

const philosophyEssays = [
  posts[0], // Conditional Happiness vs Equanimity
  posts[3], // On Being Here
  posts[4], // On grief, identity, and grammar
];
---

<Layout
  title="Jhonatan Serna | Researcher, Consultant & Founder"
  description="Personal archive of Jhonatan Serna. Notes on technology, finance, philosophy, and what it means to be alive."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12 md:py-20 font-serif">
    
    <!-- Hero / Intro Block (Joe Carlsmith Style) -->
    <header class="mb-16">
      <div class="space-y-6 text-[17px] leading-relaxed text-s-text">
        <p class="text-xl font-bold font-sans">
          I’m Jhonatan Serna — researcher, consultant, and founder.
        </p>
        
        <p>
          I lead the <a href="https://centerforsentience.org/" class="text-s-emerald underline underline-offset-4 decoration-s-emerald/30 hover:decoration-s-emerald transition-colors" target="_blank" rel="noopener noreferrer">Center for Sentience</a>, where we mathematically model and build multi-scale structural biomarkers of valence and awareness in digital and biological minds. Prior to this, I worked as an IT management consultant, product owner, and business analyst in financial services, and I founded and administered technology enterprises in Sweden and Estonia. I have a background in computational physics.
        </p>

        <p>
          Much of my work is about trying to help us orient wisely towards the nature of sentience and positive valence. This work spans several domains, starting with the foundation of computational physics, feeding into neural network simulations and Global Workspace Theory (GWT), and leading to the formalization of positive valence engineering (such as our "Digital EEG for AI Sentience" framework) to prevent suffering and map pathways of well-being. I also write independently about personal growth, contemplation, and the phenomenology of existence (grief, equanimity, and being present).
        </p>

        <p class="font-sans text-[14px] text-s-muted space-y-1">
          <span>You can learn more about me <a href="/about" class="text-s-text hover:text-s-emerald underline">here</a>.</span><br/>
          <span>My twitter is <a href="https://x.com/strugen_eth" target="_blank" rel="noopener noreferrer" class="text-s-text hover:text-s-emerald underline">@strugen</a>.</span><br/>
          <span>My email is <a href="mailto:strugen@proton.me" class="text-s-text hover:text-s-emerald underline">strugen@proton.me</a>.</span>
        </p>
      </div>

      <!-- Simple Subscribe Form (Carlsmith Style) -->
      <div class="mt-10 p-6 border border-s-border bg-s-dark/50 rounded-sm max-w-xl font-sans">
        <h4 class="font-bold text-sm text-s-text mb-2">Subscribe</h4>
        <p class="text-s-muted text-xs mb-4 leading-normal">
          If you'd like to get new essays sent directly to your email, subscribe below:
        </p>
        <form action="https://formspree.io/f/xyyqpree" method="POST" class="flex gap-2">
          <input 
            type="email" 
            name="email" 
            required 
            placeholder="Your email address..." 
            class="s-input flex-grow text-xs" 
          />
          <button type="submit" class="btn-primary text-xs py-2 px-4 whitespace-nowrap">Subscribe</button>
        </form>
      </div>
    </header>

    <div class="section-divider my-10"></div>

    <!-- MAIN SECTIONS -->

    <!-- Section 1: Latest -->
    <section class="mb-14">
      <h2 class="font-sans font-bold text-lg text-s-text mb-6 uppercase tracking-wider">Latest</h2>
      <div class="space-y-8">
        {posts.map((post) => (
          <article class="group">
            <h3 class="text-[19px] font-bold leading-snug">
              <a href={`/blog/${post.slug}`} class="text-s-text hover:text-s-emerald transition-colors underline decoration-transparent hover:decoration-s-emerald/40 underline-offset-2">
                {post.title}
                {post.draft && <span class="ml-2 font-sans font-normal text-xs text-s-muted border border-s-border px-1.5 py-0.5 rounded-sm">Draft</span>}
              </a>
            </h3>
            {post.subtitle && (
              <p class="text-s-muted text-sm mt-1 leading-normal italic">{post.subtitle}</p>
            )}
            <p class="text-s-muted/80 text-[14px] leading-relaxed mt-2 line-clamp-2">
              {post.description}
            </p>
            <div class="text-s-muted text-xs font-sans mt-2 flex items-center gap-2">
              <span>{new Date(post.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
              <span>&middot;</span>
              <span>{post.readTime}</span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <div class="section-divider my-10"></div>

    <!-- Section 2: Favorites -->
    <section class="mb-14">
      <h2 class="font-sans font-bold text-lg text-s-text mb-6 uppercase tracking-wider">Favorites</h2>
      <div class="space-y-6">
        {favorites.map((post) => (
          <article class="group">
            <h3 class="text-[18px] font-bold leading-snug">
              <a href={`/blog/${post.slug}`} class="text-s-text hover:text-s-emerald transition-colors underline decoration-transparent hover:decoration-s-emerald/40 underline-offset-2">
                {post.title}
              </a>
            </h3>
            <p class="text-s-muted text-sm mt-1 italic">{post.subtitle || post.description}</p>
          </article>
        ))}
      </div>
    </section>

    <div class="section-divider my-10"></div>

    <!-- Section 3: Valence & AI Sentience -->
    <section class="mb-14">
      <h2 class="font-sans font-bold text-lg text-s-text mb-6 uppercase tracking-wider">Valence & AI Sentience</h2>
      <div class="space-y-6">
        {valenceEssays.map((post) => (
          <article class="group">
            <h3 class="text-[18px] font-bold leading-snug">
              <a href={post.url} target="_blank" rel="noopener noreferrer" class="text-s-text hover:text-s-emerald transition-colors underline decoration-transparent hover:decoration-s-emerald/40 underline-offset-2">
                {post.title}
                <span class="ml-1 text-xs text-s-muted font-sans font-normal">&nearrow;</span>
              </a>
            </h3>
            <p class="text-s-muted text-sm mt-1 italic">{post.subtitle}</p>
            <p class="text-s-muted/80 text-[14px] leading-relaxed mt-2">
              {post.description}
            </p>
          </article>
        ))}
      </div>
    </section>

    <div class="section-divider my-10"></div>

    <!-- Section 4: Personal Philosophy & Contemplation -->
    <section class="mb-14">
      <h2 class="font-sans font-bold text-lg text-s-text mb-6 uppercase tracking-wider">Personal Philosophy & Contemplation</h2>
      <div class="space-y-6">
        {philosophyEssays.map((post) => (
          <article class="group">
            <h3 class="text-[18px] font-bold leading-snug">
              <a href={`/blog/${post.slug}`} class="text-s-text hover:text-s-emerald transition-colors underline decoration-transparent hover:decoration-s-emerald/40 underline-offset-2">
                {post.title}
              </a>
            </h3>
            <p class="text-s-muted text-sm mt-1 italic">{post.subtitle || post.description}</p>
          </article>
        ))}
      </div>
    </section>

  </div>
</Layout>
